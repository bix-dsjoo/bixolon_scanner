      {"kind": "regularized_linear_ridge", "alpha": 10.0},
      {"kind": "cosine_prototype"}
    ],
    "finetune": {
      "epochs": 1,
      "batch_size": 48,
      "workers": 4,
      "backbone_learning_rate": 0.00001,
      "head_learning_rate": 0.001,
      "weight_decay": 0.0001,
      "label_smoothing": 0.05,
      "resolution_consistency_weight": 0.2,
      "unfreeze_last_stages": 1
    }
  },
  "routing": {
    "primary_margin_candidates": [0.04, 0.06, 0.08, 0.1, 0.14, 0.18],
