    "verifier_margin_candidates": [0.0, 0.02, 0.04, 0.06, 0.1, 0.16, 0.24],
    "training_policy": "one inner source-view fold trains calibration model; the other inner fold selects a global policy"
  },
  "selection": {
    "fold_policy": "source-view-grouped-three-fold",
    "inner_policy": "next_fold_train_remaining_fold_calibrate",
    "priority": [
      "wrong_approved_count",
      "top3_miss_count",
      "negative_correct_approved_count",
      "reject_approved_count",
      "fallback_count",
      "verifier_count"
