{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bixolon.local/schemas/scan-response-2.0.json",
  "title": "ScanResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "status",
    "reason_codes",
    "segmentations",
    "processing_time_ms",
    "worker_version",
    "detector_version",
    "classifier_version"
  ],
  "properties": {
    "request_id": {"type": "string", "minLength": 8},
    "status": {
      "type": "string",
      "enum": ["SEGMENTATION", "IMAGE_RECAPTURE", "ERROR"]
    },
    "reason_codes": {
      "type": "array",
      "description": "SEGMENTATION aggregate reasons use SEGMENT_BELOW_APPROVAL_THRESHOLD, SEGMENT_DUPLICATE_REVIEW_REQUIRED, and SEGMENT_RECAPTURE_REQUIRED in decision order.",
      "items": {"type": "string"}
    },
    "segmentations": {
      "type": "array",
      "items": {"$ref": "#/$defs/Segmentation"}
    },
    "processing_time_ms": {"type": "number", "minimum": 0},
    "worker_version": {"type": "string", "minLength": 1},
    "detector_version": {"type": ["string", "null"]},
    "classifier_version": {"type": ["string", "null"]}
  },
  "$defs": {
    "BoundingBox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "exclusiveMinimum": 0},
        "height": {"type": "integer", "exclusiveMinimum": 0}
      }
    },
    "Prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class_id", "class_name"],
      "properties": {
        "class_id": {"type": "string", "minLength": 1},
        "class_name": {"type": "string", "minLength": 1}
      }
    },
    "Candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class_id", "class_name", "confidence"],
      "properties": {
        "class_id": {"type": "string", "minLength": 1},
        "class_name": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "Segmentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segmentation_id",
        "bbox",
        "status",
        "reason_codes",
        "prediction",
        "top3",
        "confidence"
      ],
      "properties": {
        "segmentation_id": {
          "type": "string",
          "pattern": "^segmentation_\\d{3,}$"
        },
        "bbox": {"$ref": "#/$defs/BoundingBox"},
        "status": {
          "type": "string",
          "enum": ["APPROVED", "UNKNOWN", "SEGMENT_RECAPTURE"]
        },
        "reason_codes": {
          "type": "array",
          "description": "UNKNOWN uses exactly one of BELOW_APPROVAL_THRESHOLD or DETECTOR_CONTAINED_DUPLICATE.",
          "items": {"type": "string"}
        },
        "prediction": {
          "anyOf": [
            {"$ref": "#/$defs/Prediction"},
            {"type": "null"}
          ]
        },
        "top3": {
          "type": "array",
          "maxItems": 3,
          "items": {"$ref": "#/$defs/Candidate"}
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
