{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bixolon.local/schemas/scan-response-1.0.json",
  "title": "ScanResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "status",
    "reason_codes",
    "items",
    "processing_time_ms",
    "model_versions"
  ],
  "properties": {
    "request_id": {"type": "string", "minLength": 8},
    "status": {
      "type": "string",
      "enum": ["APPROVED", "UNKNOWN", "RECAPTURE", "ERROR"]
    },
    "reason_codes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "items": {
      "type": "array",
      "items": {"$ref": "#/$defs/ScanItem"}
    },
    "processing_time_ms": {"type": "number", "minimum": 0},
    "model_versions": {"$ref": "#/$defs/ModelVersions"}
  },
  "$defs": {
    "BoundingBox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "exclusiveMinimum": 0},
        "height": {"type": "integer", "exclusiveMinimum": 0}
      }
    },
    "Prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class_id", "class_name"],
      "properties": {
        "class_id": {"type": "string", "minLength": 1},
        "class_name": {"type": "string", "minLength": 1}
      }
    },
    "Candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class_id", "class_name", "confidence"],
      "properties": {
        "class_id": {"type": "string", "minLength": 1},
        "class_name": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "ScanItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "bbox",
        "status",
        "reason_codes",
        "prediction",
        "top3",
        "confidence"
      ],
      "properties": {
        "item_id": {"type": "string", "pattern": "^item_\\d{3,}$"},
        "bbox": {"$ref": "#/$defs/BoundingBox"},
        "status": {"type": "string", "enum": ["APPROVED", "UNKNOWN"]},
        "reason_codes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "prediction": {
          "anyOf": [
            {"$ref": "#/$defs/Prediction"},
            {"type": "null"}
          ]
        },
        "top3": {
          "type": "array",
          "maxItems": 3,
          "items": {"$ref": "#/$defs/Candidate"}
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "ModelVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detector", "classifier"],
      "properties": {
        "detector": {"type": ["string", "null"]},
        "classifier": {"type": ["string", "null"]}
      }
    }
  }
}
